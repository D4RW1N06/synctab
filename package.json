{
  "name": "synctab",
  "version": "0.1.0",
  "description": "Synchronized tab viewer for bands",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "check-lang": "node tools/check-lang.js"
  },
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@coderline/alphatab": "^1.8.4",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "productName": "SyncTab",
  "build": {
    "appId": "hu.synctab.app",
    "productName": "SyncTab",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "public/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "SyncTab-Setup-${version}.${ext}"
    }
  },
  "author": "SyncTab contributors",
  "keywords": [
    "guitar-pro",
    "tablature",
    "band",
    "rehearsal",
    "synchronization",
    "alphatab",
    "electron"
  ]
}
